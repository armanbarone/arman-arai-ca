    },
    {
      "kind": "p",
      "text": "☐  Names, addresses, event dates, province, venues and guest count match every document."
    },
    {
      "kind": "p",
      "text": "☐  The accepted proposal is attached and the website package description has been reconciled."
    },
    {
      "kind": "p",
      "text": "☐  Coverage, personnel, photo, film, audio, album and social deliverables are stated exactly."
    },
    {
      "kind": "p",
      "text": "☐  Prices, currency, taxes, booking payment, balance dates and refund terms are complete."
    },
    {
      "kind": "p",
      "text": "☐  Required provincial consumer contract information and cancellation wording have been reviewed."
    },
    {
      "kind": "p",
      "text": "☐  Quebec language requirements have been addressed before any Quebec client signs."
    },
    {
      "kind": "p",
      "text": "☐  Optional publicity and marketing choices remain genuinely optional."
    },
    {
      "kind": "p",
      "text": "☐  No internal camera, audio, crew, security or family-conflict notes appear in a client document."
    }
