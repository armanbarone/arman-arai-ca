    {
      "kind": "p",
      "text": "Canadian Wedding Client Document System"
    },
    {
      "kind": "p",
      "text": "Internal operating guide for wedding photography filmmaking and optional planning services"
    },
    {
      "kind": "table",
      "id": "guide-2",
      "header": true,
      "rows": [
        [
          {
            "text": "ARASAKA INC.operating as ARMAN ARAI"
          },
          {
            "text": "Internal use onlyTemplate version 2026 10"
          }
        ]
      ]
    },
    {
      "kind": "p",
      "text": "This guide controls when each wedding document is prepared, approved and retained. The signed agreement, accepted proposal and approved change orders govern the project. Operational forms must match those documents and must not quietly expand the scope."
    },
    {
      "kind": "h",
      "text": "Operating rules"
    },
    {
      "kind": "p",
      "text": "Use one project identifier in every proposal, agreement, invoice, questionnaire, approval, gallery and production record."
    },
    {
      "kind": "p",
      "text": "Write exact calendar dates, local time zones, coverage windows, quantities, formats and delivery dates."
    },
    {
      "kind": "p",
      "text": "Separate mandatory service information from optional portfolio, testimonial and marketing consent."
    },
    {
      "kind": "p",
      "text": "Do not promise uninterrupted coverage, drone use, a specific weather result or any image that depends on venue rules, safety, timing or third parties."
    },
    {
      "kind": "p",
      "text": "Record every scope, date, price, tax, personnel or deliverable change in a signed change order."
    },
    {
      "kind": "p",
      "text": "Keep guest and minor publicity releases separate from the couple's own publicity choice."
    },
    {
      "kind": "p",
      "text": "Do not use the English agreement for a Quebec consumer contract until the required French version and language process have been reviewed."
    },
    {
      "kind": "p",
      "text": "Retain the final signed agreement, attachments, invoices, receipts, approvals and delivery record together."
    },
